# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=45.0

# Optional Groq Free-Tier Cloud LLM
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Data & Storage Paths
DATABASE_PATH=./data/support_tickets.db
CSV_PATH=./data/support_tickets.csv

# Application Settings
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Anomaly Detection Parameters
ANOMALY_RESPONSE_PERCENTILE=95
ANOMALY_RESOLUTION_IQR_MULTIPLIER=1.5
