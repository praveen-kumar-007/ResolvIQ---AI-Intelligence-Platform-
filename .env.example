# ==============================================================================
# ResolvIQ — AI-Powered Customer Support Ticket Analytics System
# Environment Configuration & Deployment Specification (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Provider Priority:
# - 'groq'   : Cloud inference via Groq's high-speed LPU (Fastest, ~100-300ms)
# - 'ollama' : 100% Offline local inference via Ollama (Zero API keys, private)
# If Groq token limit / rate limit is exceeded, ResolvIQ automatically falls back
# to Ollama (or local deterministic AST parsing if Ollama is not running).
LLM_PROVIDER=ollama

# Local Ollama Settings (When using LLM_PROVIDER=ollama or as Groq fallback)
# Recommended models: 'qwen2.5:7b', 'llama3.1:8b', 'mistral:7b', or 'qwen3:8b'
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=45.0

# Cloud Groq Settings (Get free API key at: https://console.groq.com)
# Recommended models: 'llama-3.3-70b-versatile', 'llama-3.1-8b-instant'
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. DATA STORAGE & PERSISTENCE
# ------------------------------------------------------------------------------
# Path to SQLite database and source CSV file
DATABASE_PATH=./data/support_tickets.db
CSV_PATH=./data/support_tickets.csv

# ------------------------------------------------------------------------------
# 3. SERVER & ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
WORKERS=2
LOG_LEVEL=INFO
DOCS_ENABLED=true
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. STATISTICAL ANOMALY DETECTION ENGINE
# ------------------------------------------------------------------------------
# Response time anomaly threshold (Percentile cut-off, default: 95th percentile)
ANOMALY_RESPONSE_PERCENTILE=95.0

# Resolution time anomaly threshold (Tukey's IQR multiplier: Q3 + k * IQR, default: 1.5)
ANOMALY_RESOLUTION_IQR_MULTIPLIER=1.5
