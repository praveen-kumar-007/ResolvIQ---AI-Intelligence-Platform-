# ==============================================================================
# ResolvIQ - Production Environment Variables Template
# Copy this file to .env or set these in your production container/host environment
# ==============================================================================

ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
WORKERS=4
LOG_LEVEL=INFO
DOCS_ENABLED=true
CORS_ORIGINS=*

# LLM Configuration
# For production without GPU: configure GROQ_API_KEY for free ~300ms cloud inference
# Or omit to automatically utilize ResolvIQ's instant deterministic fallback engine (<5ms)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=45.0

# Optional: Groq Free-Tier Cloud LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Persistence Paths
DATABASE_PATH=./data/support_tickets.db
CSV_PATH=./data/support_tickets.csv

# Anomaly Thresholds
ANOMALY_RESPONSE_PERCENTILE=95.0
ANOMALY_RESOLUTION_IQR_MULTIPLIER=1.5
